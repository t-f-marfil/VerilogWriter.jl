etherFrameTxBuffers_tcptx_pu::ufp_ready ---> etherFrameGenerator_tcptx_pu::wready
etherFrameGenerator_tcptx_pu::wvalid ---> etherFrameTxBuffers_tcptx_pu::ufp_valid
etherFrameGenerator_tcptx_pu::wready_out ---> IpPacketSimpleGenerator_tcptx_pu::wready
tcpPacketGenerator_tcptx_pu::dfp_data ---> IpPacketSimpleGenerator_tcptx_pu::wdata_in
IpPacketSimpleGenerator_tcptx_pu::wready_out ---> tcpPacketGenerator_tcptx_pu::dfp_data_ready
IpPacketSimpleGenerator_tcptx_pu::wdata ---> etherFrameGenerator_tcptx_pu::wdata_in
@enduml
